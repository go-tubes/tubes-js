{
  "name": "@go-tubes/tubes-js",
  "version": "0.1.0",
  "description": "Client library for tubes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./protobuf": {
      "types": "./dist/protobuf.d.ts",
      "import": "./dist/protobuf.js",
      "require": "./dist/protobuf.cjs"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist/*",
    "proto:gen": "buf generate",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.70.0",
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@types/jest": "^29.1.2",
    "jest": "^29.1.2",
    "jest-environment-jsdom": "^29.7.0",
    "shx": "0.3.4",
    "ts-jest": "^29.0.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/go-tubes/tubes-js.git"
  },
  "author": {
    "name": "Khadim Fall",
    "email": "info@khadimfall.com",
    "url": "https://khad.im"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/go-tubes/tubes-js/issues"
  },
  "homepage": "https://github.com/go-tubes/tubes-js#readme",
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0"
  }
}